@model IEnumerable<parcial_programacion.Models.Mascota>

@{
    ViewData["Title"] = "Registro de mascotas";
}

<div class="pet-page">
    <div class="pet-heading">
        <p class="eyebrow">Registro temporal</p>
        <h1>Mis mascotas</h1>
        <p class="lead">Agrega los datos de tus mascotas y consúltalos en esta misma página.</p>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success" role="alert">@mensaje</div>
    }

    <div class="row g-4 align-items-start">
        <div class="col-lg-5">
            <section class="pet-panel">
                <h2>Registrar mascota</h2>
                <p class="text-muted">Los datos se guardan solo mientras la aplicación esté ejecutándose.</p>
                <form asp-action="RegistrarMascota" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label for="Nombre" class="form-label">Nombre</label>
                        <input id="Nombre" name="Nombre" class="form-control" placeholder="Ej. Luna" required />
                        <span class="text-danger" data-valmsg-for="Nombre"></span>
                    </div>
                    <div class="mb-3">
                        <label for="Especie" class="form-label">Especie</label>
                        <select id="Especie" name="Especie" class="form-select" required>
                            <option value="">Selecciona una especie</option>
                            <option>Perro</option>
                            <option>Gato</option>
                            <option>Ave</option>
                            <option>Otra</option>
                        </select>
                        <span class="text-danger" data-valmsg-for="Especie"></span>
                    </div>
                    <div class="mb-3">
                        <label for="Raza" class="form-label">Raza</label>
                        <input id="Raza" name="Raza" class="form-control" placeholder="Ej. Criollo" required />
                        <span class="text-danger" data-valmsg-for="Raza"></span>
                    </div>
                    <div class="mb-4">
                        <label for="Edad" class="form-label">Edad en años</label>
                        <input id="Edad" name="Edad" type="number" min="0" max="100" class="form-control" placeholder="Ej. 3" required />
                        <span class="text-danger" data-valmsg-for="Edad"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Guardar mascota</button>
                </form>
            </section>
        </div>

        <div class="col-lg-7">
            <section class="pet-list">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2>Mascotas registradas</h2>
                    <span class="pet-count">@Model.Count()</span>
                </div>
                @if (!Model.Any())
                {
                    <div class="empty-state">
                        <span class="empty-icon">+</span>
                        <p>Aún no hay mascotas registradas.</p>
                    </div>
                }
                else
                {
                    <div class="pet-items">
                        @foreach (var mascota in Model)
                        {
                            <article class="pet-item">
                                <div class="pet-avatar">@mascota.Nombre.Substring(0, 1).ToUpper()</div>
                                <div>
                                    <h3>@mascota.Nombre</h3>
                                    <p>@mascota.Especie · @mascota.Raza</p>
                                </div>
                                <strong>@mascota.Edad @(mascota.Edad == 1 ? "año" : "años")</strong>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
